{
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "kidz.teamwachsbleiche.de" }],
      "destination": "/kidz/sommerfest",
      "permanent": false
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "kidz.kaiblobel.de" }],
      "destination": "https://kidz.teamwachsbleiche.de/kidz/sommerfest",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "kidz.kaiblobel.de" }],
      "destination": "https://kidz.teamwachsbleiche.de/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/e", "destination": "/api/share" },
    { "source": "/p/:berater/:quelle", "destination": "/promoter-start.html?berater=:berater&quelle=:quelle" },
    { "source": "/kidz/sommerfest", "destination": "/kidz-sommerfest.html" },
    { "source": "/kidz/gewinnspiel", "destination": "/kidz-gewinnspiel.html" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
